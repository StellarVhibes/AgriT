NODE_ENV=development
PORT=8000

STELLAR_NETWORK=testnet

# Contract IDs for the volatility_shield (AgriTrust VYC) contract.
# Deploy the contract using: cd smartcontract && make deploy-testnet
# After deployment, update this with the actual contract ID from Stellar testnet
TESTNET_CONTRACT_ID=
MAINNET_CONTRACT_ID=

# The protocol admin keypair. Its PUBLIC key must be the admin of the
# volatility_shield contract (set via init/transfer_admin, e.g. during deploy).
# It signs mint_vyc and update_status submissions. Keep the secret here only —
# never in the frontend or in a commit. When unset, on-chain writes fail with a
# clear "not configured" error; read-only endpoints still work when you pass a
# ?source= testnet account that exists.
ADMIN_SECRET_KEY=

# Optional read-side gate for /admin/* endpoints. When set, those endpoints
# require a matching `x-admin-token` request header. When unset, /admin/* is
# open — fine for a demo, tighten before a public production launch.
ADMIN_API_TOKEN=

CACHE_TTL_SECONDS=60
HORIZON_TIMEOUT=30000

# Optional: override the directory used by history.service.ts (defaults to
# <cwd>/data). Useful in containerized deploys with a mounted volume.
AGRITRUST_DATA_DIR=